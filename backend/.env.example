# Copia este archivo como .env  (el .env real NO se sube a git)
DB_HOST=localhost
DB_PORT=5432
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo123
DB_NAME=multicatalogo
DB_SSLMODE=disable
PORT=3000

# --- Redis (Fase 3: caché) ---
# Alternativa: REDIS_URL=redis://:clave@localhost:6379/0  (si existe, reemplaza a HOST/PORT)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Fase 4: SOLO para demostrar el ROLLBACK en clase (dejar vacío en uso normal) ---
#   FALLA_CHECKOUT=antes_items   -> error forzado tras insertar el pedido y antes de los items
#   FALLA_CHECKOUT=pausa         -> pausa antes del COMMIT (para hacer `docker kill multicatalogo-db`)
FALLA_CHECKOUT=
PAUSA_CHECKOUT_SEG=10

# --- Seguridad (JWT + bcrypt) ---
# Secreto HS256 para firmar tokens (cámbialo en producción).
JWT_SECRET=dev-secret-cambiar-en-produccion-multicatalogo
# APP_ENV=dev  -> incluye "details" en errores API; otro valor los oculta.
APP_ENV=dev
